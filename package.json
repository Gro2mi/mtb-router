{
  "name": "mtb-router",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --strategy localStorage --emit-ts-declarations",
    "sync:worker": "node scripts/sync-maplibre-worker.mjs",
    "prepare": "paraglide-js compile --project ./project.inlang --strategy localStorage --emit-ts-declarations && node scripts/sync-maplibre-worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@inlang/paraglide-js": "^2.0.0",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^9.20.0",
    "eslint-plugin-svelte": "^3.0.0",
    "geojson-vt": "^5.0.4",
    "globals": "^17.14.0",
    "pbf2json": "^7.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vt-pbf": "^3.1.3"
  }
}
